rules_version = '2';
// LifeCity · reglas de Firestore
//  users/{uid}                  perfil + plan (el plan NO lo puede subir el usuario, salvo con licencia)
//  users/{uid}/projects/{pid}   proyectos del usuario (solo su dueño los ve y edita)
//  licenses/{code}              claves PRO {plan, months}: se crean a mano en la consola; solo se leen
//                               conociendo el código exacto (no se pueden listar)
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function licensePath(code) { return /databases/$(database)/documents/licenses/$(code); }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.plan == 'free'
        && !request.resource.data.keys().hasAny(['planSince', 'planMonths', 'license']);
      allow update: if isOwner(uid) && (
        // datos de perfil
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'photo', 'lastLogin'])
        // canje de licencia (va en el mismo batch que la actualización de licenses/{code})
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'planSince', 'planMonths', 'license'])
          && exists(licensePath(request.resource.data.license))
          && get(licensePath(request.resource.data.license)).data.get('usedBy', null) == null
          && getAfter(licensePath(request.resource.data.license)).data.usedBy == uid
          && request.resource.data.plan == get(licensePath(request.resource.data.license)).data.plan
          && request.resource.data.planMonths == get(licensePath(request.resource.data.license)).data.months
          && request.resource.data.planSince == request.time
        )
      );

      match /projects/{pid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120;
      }
    }

    match /licenses/{code} {
      allow get: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.get('usedBy', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.license == code;
    }
  }
}
